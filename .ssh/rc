# sshd runs this for every connection, before the shell -- so the relink also fires for
# `ssh host cmd` and `ssh -t tmux attach`, neither of which reaches a login shell.
# Never write to stdout here: it is piped to xauth.

if [ -S "$SSH_AUTH_SOCK" ] && [ ! -S "$HOME/.ssh/ssh_auth_sock" ]; then
    ln -sfn "$SSH_AUTH_SOCK" "$HOME/.ssh/ssh_auth_sock"
fi

# Creating this file replaces sshd's built-in xauth handling, so redo it.
if read proto cookie && [ -n "$DISPLAY" ]; then
    case "$DISPLAY" in
        localhost:*) echo add "unix:${DISPLAY#localhost:}" "$proto" "$cookie" ;;
        *)           echo add "$DISPLAY" "$proto" "$cookie" ;;
    esac | xauth -q -
fi

exit 0

#!/usr/bin/env python3
"""Copy a git worktree's tracked files onto another checkout of the same commit.

SRC and DST are named rsync-style; either may be remote ([user@]host:path).
With a single argument, it is the SRC and the sync is a pull into the current
directory. Refuses to transfer unless DST is on the same branch + commit as SRC
and has no uncommitted changes to tracked files. --force skips those checks.
Extra rsync args go after --.

    sync-tree builder:/opt/workspace/src/ducktest/az/duckdb     # pull into .
    sync-tree builder:/opt/src/duckdb ~/src/duckdb -n
    sync-tree ~/src/duckdb builder:/opt/src/duckdb -- --exclude '*.parquet'
"""

import argparse
import shlex
import subprocess
import sys

# ssh runs the login shell, so both sides go through bash -s for one dialect.
PROLOGUE = """
case "$1" in "~"|"~/"*) set -- "$HOME${1#"~"}";; esac
cd "$1" || exit 1
"""


def die(msg):
    sys.exit(f"sync-tree: {msg}")


class Repo:
    def __init__(self, spec):
        remote = ":" in spec.split("/", 1)[0]
        self.host, self.path = spec.split(":", 1) if remote else (None, spec)

    def __str__(self):
        return f"{self.host}:{self.path}" if self.host else self.path

    def run(self, script, what):
        if self.host:
            cmd = ["ssh", self.host, "bash", "-s", "--", shlex.quote(self.path)]
        else:
            cmd = ["bash", "-s", "--", self.path]
        r = subprocess.run(cmd, input=PROLOGUE + script, capture_output=True, text=True)
        if r.returncode:
            die(f"cannot {what} {self}: {r.stderr.strip() or f'exit {r.returncode}'}")
        return r.stdout

    def probe(self):
        out = self.run(
            "git rev-parse --show-toplevel && "
            "git rev-parse HEAD && "
            "git rev-parse --abbrev-ref HEAD && "
            "git status --porcelain --untracked-files=no",
            "inspect",
        ).splitlines()
        self.path, self.head, self.branch, self.dirty = out[0], out[1], out[2], out[3:]

    def files(self):
        out = self.run(
            'git ls-files -z --recurse-submodules | while IFS= read -r -d "" f; do '
            'if [ -e "$f" ] || [ -L "$f" ]; then printf "%s\\0" "$f"; fi; done',
            "list tracked files in",
        )
        return [f for f in out.split("\0") if f]


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("src", help="[[user@]host:]/path/to/checkout")
    ap.add_argument("dst", nargs="?", help="[[user@]host:]/path/to/checkout (default: cwd)")
    ap.add_argument("-n", "--dry-run", action="store_true")
    ap.add_argument("-f", "--force", action="store_true", help="transfer even if the destination disagrees")
    ap.add_argument("rsync_args", nargs="*", help="extra rsync args, after --")

    # Split on -- ourselves; argparse eats the separator and then reads --exclude as its own flag.
    argv = sys.argv[1:]
    extra = []
    if "--" in argv:
        cut = argv.index("--")
        argv, extra = argv[:cut], argv[cut + 1:]
    args = ap.parse_args(argv)

    src, dst = Repo(args.src), Repo(args.dst if args.dst else ".")
    if args.dst is None and not src.host:
        die(f"with one argument it must be remote (host:path) and is pulled into .; got {args.src!r}")
    if src.host and dst.host:
        die("rsync cannot go remote -> remote")

    src.probe()
    dst.probe()
    problems = []
    if dst.head != src.head:
        problems.append(f"commit: src {src.head[:12]} ({src.branch}) != dst {dst.head[:12]} ({dst.branch})")
    elif dst.branch != src.branch:
        problems.append(f"branch: src {src.branch} != dst {dst.branch}")
    if dst.dirty:
        problems.append(f"dst has {len(dst.dirty)} uncommitted change(s): " + ", ".join(s[3:] for s in dst.dirty[:5]))
    if problems and not args.force:
        for p in problems:
            print(f"sync-tree: {p}", file=sys.stderr)
        q = shlex.quote(dst.path)
        fix = f"git -C {q} fetch && git -C {q} checkout {src.branch}"
        die(f"fix it, e.g. {f'ssh {dst.host} {shlex.quote(fix)}' if dst.host else fix}")
    for p in problems:
        print(f"sync-tree: WARNING (forced past) {p}", file=sys.stderr)

    files = src.files()
    if not files:
        die(f"no tracked files to send from {src}")

    cmd = ["rsync", "-a", "-v", "--files-from=-", "--from0", *extra, f"{src}/", str(dst)]
    if args.dry_run:
        cmd.insert(1, "-n")
    print(f"sync-tree: {len(files)} tracked files {src} -> {dst} @ {src.head[:12]}", flush=True)
    sys.exit(subprocess.run(cmd, input="\0".join(files) + "\0", text=True).returncode)


if __name__ == "__main__":
    main()

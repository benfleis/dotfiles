#!/usr/bin/env python3
"""Push a git worktree's tracked files to the same checkout on another box.

Refuses to transfer unless the remote is on the same branch + commit, and has no
uncommitted changes to tracked files. --force skips those checks.

    sync-tree builder:/opt/workspace/src/ducktest/az/duckdb
    sync-tree --src ~/src/duckdb builder:/opt/src/duckdb -n
    sync-tree builder:/opt/src/duckdb -- --exclude '*.parquet'
"""

import argparse
import os
import shlex
import subprocess
import sys


def die(msg):
    sys.exit(f"sync-tree: {msg}")


def git(repo, *args):
    r = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    if r.returncode:
        die(f"git {' '.join(args)} failed: {r.stderr.strip()}")
    return r.stdout


def remote_state(host, path):
    q = shlex.quote(path)
    script = (
        f"git -C {q} rev-parse HEAD && "
        f"git -C {q} rev-parse --abbrev-ref HEAD && "
        f"git -C {q} status --porcelain --untracked-files=no"
    )
    r = subprocess.run(["ssh", host, script], capture_output=True, text=True)
    if r.returncode:
        die(f"cannot read {host}:{path}: {r.stderr.strip() or 'ssh failed'}")
    lines = r.stdout.splitlines()
    return lines[0], lines[1], lines[2:]


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("dest", help="[user@]host:/path/to/checkout")
    ap.add_argument("--src", default=".", help="local worktree (default: cwd)")
    ap.add_argument("-n", "--dry-run", action="store_true")
    ap.add_argument("-f", "--force", action="store_true", help="transfer even if the remote disagrees")
    ap.add_argument("rsync_args", nargs="*", help="extra rsync args, after --")

    # Split on -- ourselves; argparse eats the separator and then reads --exclude as its own flag.
    argv = sys.argv[1:]
    extra = []
    if "--" in argv:
        cut = argv.index("--")
        argv, extra = argv[:cut], argv[cut + 1:]
    args = ap.parse_args(argv)
    args.rsync_args = extra

    if ":" not in args.dest:
        die(f"dest must be host:path, got {args.dest!r}")
    host, path = args.dest.split(":", 1)

    src = git(args.src, "rev-parse", "--show-toplevel").strip()
    head = git(src, "rev-parse", "HEAD").strip()
    branch = git(src, "rev-parse", "--abbrev-ref", "HEAD").strip()

    r_head, r_branch, r_dirty = remote_state(host, path)
    problems = []
    if r_head != head:
        problems.append(f"commit: local {head[:12]} ({branch}) != remote {r_head[:12]} ({r_branch})")
    elif r_branch != branch:
        problems.append(f"branch: local {branch} != remote {r_branch}")
    if r_dirty:
        problems.append(f"remote has {len(r_dirty)} uncommitted change(s): " + ", ".join(s[3:] for s in r_dirty[:5]))
    if problems and not args.force:
        for p in problems:
            print(f"sync-tree: {p}", file=sys.stderr)
        die(f"fix it, e.g. ssh {host} 'git -C {shlex.quote(path)} fetch && git -C {shlex.quote(path)} checkout {branch}'")
    for p in problems:
        print(f"sync-tree: WARNING (forced past) {p}", file=sys.stderr)

    # Tracked files only, minus any deleted in the worktree -- rsync errors on a missing source file.
    files = [f for f in git(src, "ls-files", "-z", "--recurse-submodules").split("\0") if f]
    files = [f for f in files if os.path.lexists(os.path.join(src, f))]
    if not files:
        die("no tracked files to send")

    cmd = ["rsync", "-a", "-v", "--files-from=-", "--from0", *args.rsync_args, src + "/", args.dest]
    if args.dry_run:
        cmd.insert(1, "-n")
    print(f"sync-tree: {len(files)} tracked files -> {args.dest} @ {head[:12]}", flush=True)
    sys.exit(subprocess.run(cmd, input="\0".join(files) + "\0", text=True).returncode)


if __name__ == "__main__":
    main()
